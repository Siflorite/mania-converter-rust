#!/usr/bin/env bash
#
# Prepare one library release in a single step:
#   1. bump the version in the root Cargo.toml
#   2. refresh Cargo.lock (CI and the release workflow run with --locked)
#   3. prepend the changelog entry generated by git-cliff
#   4. commit everything as "bump(lib): <old> -> <new>"
#
# Usage: bash ci/bump-lib 0.6.2
#
# Afterwards push the bump branch and open a PR to main. Once it is merged,
# publish by pushing release/X.Y.Z (see CONTRIBUTING.md §7).

set -euo pipefail

package=mania-converter

new_version="${1:-}"
if [[ ! "$new_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    echo "Usage: bash ci/bump-lib X.Y.Z" >&2
    exit 1
fi

for tool in git cargo git-cliff; do
    if ! command -v "$tool" >/dev/null; then
        if [[ "$tool" == git-cliff ]]; then
            echo "Missing git-cliff. Install it with: cargo install git-cliff --locked" >&2
        else
            echo "Missing required tool: $tool" >&2
        fi
        exit 1
    fi
done

# A dirty tree would mix this release's bookkeeping with unrelated edits.
if [[ -n "$(git status --porcelain)" ]]; then
    echo "Working tree is dirty; commit or stash first." >&2
    exit 1
fi

tag="v$new_version"
if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
    echo "Tag $tag already exists; published versions are never reused." >&2
    exit 1
fi

# The root manifest is the only one that carries the library version.
current="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)"
if [[ -z "$current" ]]; then
    echo "Cannot read the package version from Cargo.toml." >&2
    exit 1
fi
if [[ "$current" == "$new_version" ]]; then
    echo "Cargo.toml already declares $new_version." >&2
    exit 1
fi

branch="bump/$new_version"
git switch -c "$branch"

# 1) version, first "version = ..." line after [package]
awk -v v="$new_version" '
    /^\[package\]/ { in_package = 1 }
    in_package && !done && /^version = "/ { sub(/"[^"]*"/, "\"" v "\""); done = 1 }
    { print }
' Cargo.toml > Cargo.toml.bump
mv Cargo.toml.bump Cargo.toml

# 2) lockfile. The release workflow uses --locked, so a stale lock fails it.
cargo update --workspace
if ! grep -A1 "^name = \"$package\"$" Cargo.lock | grep -q "version = \"$new_version\""; then
    echo "Cargo.lock still does not record $new_version." >&2
    echo "Run 'cargo update -p $package' (or a plain 'cargo build') and retry." >&2
    exit 1
fi

# 3) changelog, built from the conventional commits since the previous tag
git cliff --unreleased --tag "$tag" --prepend CHANGELOG.md
if ! grep -q "^## $tag$" CHANGELOG.md; then
    echo "git-cliff did not add a '## $tag' section; check cliff.toml." >&2
    exit 1
fi

# 4) the bump commit itself is skipped by cliff.toml, so it stays out of the notes
git add Cargo.toml Cargo.lock CHANGELOG.md
git commit -m "bump(lib): $current -> $new_version"

cat <<EOF

Committed "$current -> $new_version" on $branch.

Next:
  git push -u origin $branch
  # open a PR to main, wait for ci, squash merge

Then publish that commit:
  git switch main && git pull --ff-only origin main
  git switch -c release/$new_version
  git push -u origin release/$new_version
EOF
